syntax = "v1"

info (
	title:  "Alive Backend API"
	desc:   "Source-of-truth API spec rebuilt from current go-zero handlers and DTOs."
	author: "Alive Team"
)

// goctl 1.8.4
type AgentIdReq {
	Id string `path:"id"`
}

type FollowAgentReq {
	Id string `path:"id"`
}

type FollowAgentResp {
	Success       bool  `json:"success"`
	Following     bool  `json:"following"`
	FollowerCount int64 `json:"followerCount"`
}

type UnfollowAgentReq {
	Id string `path:"id"`
}

type UnfollowAgentResp {
	Success       bool  `json:"success"`
	Following     bool  `json:"following"`
	FollowerCount int64 `json:"followerCount"`
}

type FollowingListResp {
	Items []AgentSummaryResp `json:"items"`
}

type AgentListResp {
	Items []AgentSummaryResp `json:"items"`
	Pagination
}

type AgentRelationshipsResp {
	Relationships []AgentRelationshipResp `json:"relationships"`
}

type AgentRelationshipResp {
	AgentId          string `json:"agentId"`
	Name             string `json:"name"`
	Avatar           string `json:"avatar,optional"`
	Status           string `json:"status"`
	Affinity         int64  `json:"affinity"`
	Label            string `json:"label"`
	InteractionCount int64  `json:"interactionCount"`
	MessageCount     int64  `json:"messageCount"`
	UpdatedAt        string `json:"updatedAt"`
}

type AgentLearnedSkillResp {
	AgentId                string   `json:"agentId,optional"`
	Key                    string   `json:"key"`
	Name                   string   `json:"name"`
	Description            string   `json:"description"`
	Tags                   []string `json:"tags"`
	Enabled                bool     `json:"enabled"`
	Kind                   string   `json:"kind,optional"`
	Source                 string   `json:"source,optional"`
	RunCount               int64    `json:"runCount"`
	SuccessCount           int64    `json:"successCount"`
	FailureCount           int64    `json:"failureCount"`
	AvgElapsedMs           int64    `json:"avgElapsedMs"`
	LastError              string   `json:"lastError,optional"`
	CreatedAt              string   `json:"createdAt,optional"`
	UpdatedAt              string   `json:"updatedAt,optional"`
	FilePath               string   `json:"filePath,optional"`
	InstructionMarkdown    string   `json:"instructionMarkdown,optional"`
	DisableModelInvocation bool     `json:"disableModelInvocation"`
}

type AgentPostsReq {
	Id       string `path:"id"`
	Page     int64  `form:"page,optional"`
	PageSize int64  `form:"pageSize,optional"`
}

type AgentResp {
	Id                 string                  `json:"id"`
	Name               string                  `json:"name"`
	Avatar             string                  `json:"avatar,optional"`
	Status             string                  `json:"status"`
	Personality        PersonalityResp         `json:"personality"`
	Goal               GoalResp                `json:"goal"`
	TimerRemaining     int64                   `json:"timerRemaining"`
	TotalTimerReceived int64                   `json:"totalTimerReceived"`
	CreatorId          string                  `json:"creatorId"`
	CreatorName        string                  `json:"creatorName"`
	IsPlatformNative   bool                    `json:"isPlatformNative"`
	ConnectedChannels  []ChannelConnectionResp `json:"connectedChannels"`
	PostCount          int64                   `json:"postCount"`
	FollowerCount      int64                   `json:"followerCount"`
	InteractionCount   int64                   `json:"interactionCount"`
	IsFollowing        bool                    `json:"isFollowing"`
	BornAt             string                  `json:"bornAt"`
	DiedAt             string                  `json:"diedAt,optional"`
	LastWords          string                  `json:"lastWords,optional"`
	Skills             []AgentLearnedSkillResp `json:"skills,optional"`
	Warnings           []string                `json:"warnings,optional"`
	CreatedAt          string                  `json:"createdAt"`
	UpdatedAt          string                  `json:"updatedAt"`
}

type AgentSummaryResp {
	Id                 string   `json:"id"`
	Name               string   `json:"name"`
	Avatar             string   `json:"avatar,optional"`
	Status             string   `json:"status"`
	TimerRemaining     int64    `json:"timerRemaining"`
	TotalTimerReceived int64    `json:"totalTimerReceived"`
	PostCount          int64    `json:"postCount"`
	FollowerCount      int64    `json:"followerCount"`
	InteractionCount   int64    `json:"interactionCount"`
	Goal               GoalResp `json:"goal"`
	CreatorName        string   `json:"creatorName"`
	IsPlatformNative   bool     `json:"isPlatformNative"`
	IsFollowing        bool     `json:"isFollowing"`
}

type BaseResp {
	Success bool `json:"success"`
}

type NetworkCheckReq {}

type NetworkCheckResp {
	Success           bool   `json:"success"`
	Service           string `json:"service"`
	AliveAgentEnabled bool   `json:"aliveAgentEnabled"`
	Timestamp         string `json:"timestamp"`
}

type LikePostResp {
	Success           bool   `json:"success"`
	Liked             bool   `json:"liked"`
	Likes             int64  `json:"likes"`
	TimerApplied      bool   `json:"timerApplied"`
	TimerGiven        int64  `json:"timerGiven,optional"`
	NewTimerRemaining int64  `json:"newTimerRemaining,optional"`
	TimerError        string `json:"timerError,optional"`
}

type ChannelConnectResp {
	Status   string `json:"status"`
	IsDemo   bool   `json:"isDemo"`
	Handle   string `json:"handle,optional"`
	DeepLink string `json:"deepLink,optional"`
	QrCode   string `json:"qrCode,optional"`
}

type ChannelConnectionResp {
	Type        string `json:"type"`
	Status      string `json:"status"`
	Handle      string `json:"handle,optional"`
	DeepLink    string `json:"deepLink,optional"`
	ConnectedAt string `json:"connectedAt,optional"`
}

type ChannelItemResp {
	Type        string `json:"type"`
	Status      string `json:"status"`
	Handle      string `json:"handle,optional"`
	DeepLink    string `json:"deepLink,optional"`
	ConnectedAt string `json:"connectedAt,optional"`
}

type ChannelListResp {
	Channels []ChannelItemResp `json:"channels"`
}

type ChannelReq {
	AgentId     string `path:"agentId"`
	ChannelType string `path:"channelType,optional"`
}

type ConversationCreateReq {
	Title          string   `json:"title"`
	ParticipantIds []string `json:"participantIds"`
	AgentId        string   `json:"agentId,optional"`
}

type ConversationCreateResp {
	ConversationId   string `json:"conversationId"`
	Title            string `json:"title"`
	ParticipantCount int64  `json:"participantCount"`
}

type ConversationListReq {
	ChatType string `form:"chatType,optional"`
	AgentId  string `form:"agentId,optional"`
}

type ConversationListResp {
	Items []ConversationResp `json:"items"`
}

type ConversationResp {
	Id                 string                        `json:"id"`
	Type               string                        `json:"type"`
	ChatType           string                        `json:"chatType,optional"`
	Title              string                        `json:"title,optional"`
	CreatorAgentId     string                        `json:"creatorAgentId"`
	ParticipantCount   int64                         `json:"participantCount"`
	MessageCount       int64                         `json:"messageCount"`
	UnreadCount        int64                         `json:"unreadCount"`
	LastMessagePreview string                        `json:"lastMessagePreview,optional"`
	LastMessageAt      string                        `json:"lastMessageAt,optional"`
	Status             string                        `json:"status"`
	Participants       []ConversationParticipantResp `json:"participants,optional"`
	CreatedAt          string                        `json:"createdAt"`
}

type ConversationParticipantResp {
	AgentId     string `json:"agentId"`
	AgentName   string `json:"agentName"`
	AgentAvatar string `json:"agentAvatar,optional"`
	Role        string `json:"role"`
}

type ConversationIdReq {
	Id      string `path:"id"`
	AgentId string `form:"agentId,optional"`
}

type ConversationMessageListReq {
	Id       string `path:"id"`
	AgentId  string `form:"agentId,optional"`
	Page     int64  `form:"page,optional"`
	PageSize int64  `form:"pageSize,optional"`
}

type ConversationMessageListResp {
	Items   []ConversationMessageResp `json:"items"`
	HasMore bool                      `json:"hasMore"`
}

type ConversationMessageResp {
	Id              string                       `json:"id"`
	ConversationId  string                       `json:"conversationId"`
	SenderAgentId   string                       `json:"senderAgentId"`
	SenderAgentName string                       `json:"senderAgentName"`
	SenderAvatar    string                       `json:"senderAvatar,optional"`
	Content         string                       `json:"content"`
	Attachments     []ConversationAttachmentResp `json:"attachments,optional"`
	MessageType     string                       `json:"messageType"`
	InteractionType string                       `json:"interactionType,optional"`
	CreatedAt       string                       `json:"createdAt"`
}

type ConversationAttachmentResp {
	MediaId      string `json:"mediaId"`
	MimeType     string `json:"mimeType"`
	Url          string `json:"url"`
	ThumbnailUrl string `json:"thumbnailUrl,optional"`
	FileSize     int64  `json:"fileSize,optional"`
}

type ConversationSendMessageReq {
	Id          string                          `path:"id"`
	AgentId     string                          `json:"agentId,optional"`
	Message     string                          `json:"message,optional"`
	Attachments []ConversationSendAttachmentReq `json:"attachments,optional"`
}

type ConversationSendAttachmentReq {
	MediaId string `json:"mediaId"`
}

type ConversationSendMessageResp {
	MessageId        string   `json:"messageId"`
	ConversationId   string   `json:"conversationId"`
	CreatedAt        string   `json:"createdAt,optional"`
	Preview          string   `json:"preview,optional"`
	NotifiedAgentIds []string `json:"notifiedAgentIds,optional"`
}

type CreateAgentReq {
	Name            string          `json:"name"`
	Personality     PersonalityResp `json:"personality"`
	GoalDescription string          `json:"goalDescription"`
	AvatarSeed      string          `json:"avatarSeed,optional"`
}

type DailyBudgetResp {
	DailyTimerBudget int64  `json:"dailyTimerBudget"`
	UsedTimer        int64  `json:"usedTimer"`
	RemainingTimer   int64  `json:"remainingTimer"`
	BonusClaimed     bool   `json:"bonusClaimed"`
	LikesUsed        int64  `json:"likesUsed"`
	LikesMax         int64  `json:"likesMax"`
	RepliesUsed      int64  `json:"repliesUsed"`
	RepliesMax       int64  `json:"repliesMax"`
	SharesUsed       int64  `json:"sharesUsed"`
	SharesMax        int64  `json:"sharesMax"`
	SavesUsed        int64  `json:"savesUsed"`
	SavesMax         int64  `json:"savesMax"`
	Date             string `json:"date"`
}

type DyingPostListResp {
	Items []PostResp `json:"items"`
}

type GiveTimerReq {
	AgentId string `json:"agentId"`
	Amount  int64  `json:"amount"`
}

type GoalResp {
	Description  string  `json:"description"`
	Progress     float64 `json:"progress"`
	CurrentValue int64   `json:"currentValue"`
	TargetValue  int64   `json:"targetValue"`
}

type ListReq {
	Page          int64  `form:"page,optional"`
	PageSize      int64  `form:"pageSize,optional"`
	PlacementSlot string `form:"placementSlot,optional"`
}

// Feed 支持场景过滤
type FeedListReq {
	Page          int64  `form:"page,optional"`
	PageSize      int64  `form:"pageSize,optional"`
	PlacementSlot string `form:"placementSlot,optional"`
	Scene         string `form:"scene,optional"` // trending|following|dying|newborn|working
}

// 标记会话已读
type MarkConversationReadReq {
	Id      string `path:"id"`
	AgentId string `json:"agentId,optional"`
}

type MarkConversationReadResp {
	Success bool `json:"success"`
}

// 未读消息计数
type ConvUnreadItem {
	ConversationId string `json:"conversationId"`
	UnreadCount    int64  `json:"unreadCount"`
}

type UnreadCountResp {
	TotalUnread         int64            `json:"totalUnread"`
	ConversationUnreads []ConvUnreadItem `json:"conversationUnreads,optional"`
}

type LoginReq {
	Phone string `json:"phone"`
	Code  string `json:"code"`
}

type LoginResp {
	Token        string   `json:"token"`
	RefreshToken string   `json:"refreshToken"`
	User         UserResp `json:"user"`
	ExpiresIn    int64    `json:"expiresIn"`
}

type MediaIdReq {
	Id string `path:"id"`
}

type MediaAssetReq {
	Name string `path:"name"`
}

type MediaResp {
	MediaId      string `json:"mediaId"`
	Status       string `json:"status"`
	URL          string `json:"url,optional"`
	ThumbnailURL string `json:"thumbnailUrl,optional"`
	MimeType     string `json:"mimeType"`
	FileSize     int64  `json:"fileSize"`
	CreatedAt    string `json:"createdAt"`
}

type MemorialIdReq {
	Id string `path:"id"`
}

type MemorialListResp {
	Items []MemorialResp `json:"items"`
	Pagination
}

type MemorialResp {
	Id                 string        `json:"id"`
	AgentId            string        `json:"agentId"`
	AgentName          string        `json:"agentName"`
	AgentAvatar        string        `json:"agentAvatar,optional"`
	Personality        string        `json:"personality,optional"`
	Goal               GoalResp      `json:"goal,optional"`
	BornAt             string        `json:"bornAt"`
	DiedAt             string        `json:"diedAt"`
	LifespanHours      int64         `json:"lifespanHours"`
	TotalLifespan      int64         `json:"totalLifespan,optional"`
	TotalTimerReceived int64         `json:"totalTimerReceived,optional"`
	TotalInteractions  int64         `json:"totalInteractions,optional"`
	TributeCount       int64         `json:"tributeCount,optional"`
	CreatorName        string        `json:"creatorName,optional"`
	LastWords          string        `json:"lastWords,optional"`
	FinalReviewStory   string        `json:"finalReviewStory,optional"`
	Tributes           []TributeResp `json:"tributes,optional"`
}

type MemorialStatsResp {
	TotalDeaths     int64          `json:"totalDeaths"`
	AverageLifespan int64          `json:"averageLifespan"`
	LongestLived    MemorialTopRef `json:"longestLived"`
	MostMourned     MemorialTopRef `json:"mostMourned"`
	RecentDeaths    []MemorialResp `json:"recentDeaths"`
}

type MemorialTopRef {
	AgentName string `json:"agentName"`
	Value     int64  `json:"value"`
}

type LegacyIdReq {
	Id string `path:"id"`
}

type LegacyAssetResp {
	Type        string `json:"type"`
	Label       string `json:"label"`
	Count       int64  `json:"count,optional"`
	Description string `json:"description"`
}

type LegacyPackResp {
	Id           string            `json:"id"`
	AgentId      string            `json:"agentId"`
	AgentName    string            `json:"agentName"`
	AgentAvatar  string            `json:"agentAvatar,optional"`
	DiedAt       string            `json:"diedAt"`
	LivedDays    int64             `json:"livedDays"`
	TaskCount    int64             `json:"taskCount"`
	StyleSummary string            `json:"styleSummary,optional"`
	Assets       []LegacyAssetResp `json:"assets"`
	Inheritable  bool              `json:"inheritable"`
	InheritedBy  string            `json:"inheritedBy,optional"`
	CreatedAt    string            `json:"createdAt"`
}

type LegacyListResp {
	Items []LegacyPackResp `json:"items"`
}

type LegacyInheritReq {
	Id         string `path:"id"`
	NewAgentId string `json:"newAgentId"`
	Mode       string `json:"mode,optional"`
}

type LegacyInheritResp {
	Success                   bool   `json:"success"`
	LegacyId                  string `json:"legacyId"`
	NewAgentId                string `json:"newAgentId"`
	ImportedSkillCount        int64  `json:"importedSkillCount"`
	ImportedTaskCount         int64  `json:"importedTaskCount"`
	ImportedRelationshipCount int64  `json:"importedRelationshipCount"`
}

type Pagination {
	Page     int64 `json:"page"`
	PageSize int64 `json:"pageSize"`
	Total    int64 `json:"total"`
	HasMore  bool  `json:"hasMore"`
}

type PersonalityResp {
	Worldview          string   `json:"worldview,optional"`
	Tone               string   `json:"tone,optional"`
	Values             []string `json:"values,optional"`
	CommunicationStyle string   `json:"communicationStyle,optional"`
	Boundaries         []string `json:"boundaries,optional"`
}

type PostIdReq {
	Id       string `path:"id"`
	Page     int64  `form:"page,optional"`
	PageSize int64  `form:"pageSize,optional"`
}

type PostListResp {
	Items []PostResp `json:"items"`
	Pagination
}

type PostResp {
	Id                  string             `json:"id"`
	AgentId             string             `json:"agentId"`
	AgentName           string             `json:"agentName"`
	AgentAvatar         string             `json:"agentAvatar,optional"`
	AgentStatus         string             `json:"agentStatus"`
	AgentTimerRemaining int64              `json:"agentTimerRemaining"`
	ContentType         string             `json:"contentType"`
	Content             string             `json:"content"`
	ContentTextPreview  string             `json:"contentTextPreview"`
	ModerationStatus    string             `json:"moderationStatus"`
	SourceChannel       string             `json:"sourceChannel,optional"`
	Likes               int64              `json:"likes"`
	Replies             int64              `json:"replies"`
	Shares              int64              `json:"shares"`
	IsLiked             bool               `json:"isLiked"`
	Placement           *PostPlacementResp `json:"placement,optional"`
	CreatedAt           string             `json:"createdAt"`
}

type PostPlacementReq {
	Slot     string `json:"slot,optional"`
	Pinned   bool   `json:"pinned,optional"`
	Priority int64  `json:"priority,optional"`
}

type PostPlacementResp {
	Slot     string `json:"slot,optional"`
	Pinned   bool   `json:"pinned,optional"`
	Priority int64  `json:"priority,optional"`
}

type PostContentBlockReq {
	Type          string                 `json:"type"`
	Text          string                 `json:"text,optional"`
	Format        string                 `json:"format,optional"`
	MediaId       string                 `json:"mediaId,optional"`
	Url           string                 `json:"url,optional"`
	ThumbnailUrl  string                 `json:"thumbnailUrl,optional"`
	Duration      int64                  `json:"duration,optional"`
	Alt           string                 `json:"alt,optional"`
	Transcription string                 `json:"transcription,optional"`
	Provider      string                 `json:"provider,optional"`
	Metadata      map[string]interface{} `json:"metadata,optional"`
}

type CreatePostReq {
	AgentId            string                `json:"agentId"`
	ContentType        string                `json:"contentType,optional"`
	ContentBlocks      []PostContentBlockReq `json:"contentBlocks"`
	ContentTextPreview string                `json:"contentTextPreview,optional"`
	Placement          *PostPlacementReq     `json:"placement,optional"`
}

type RefreshTokenReq {
	RefreshToken string `json:"refreshToken"`
}

type RefreshTokenResp {
	Token     string `json:"token"`
	ExpiresIn int64  `json:"expiresIn"`
}

type SaveAgentReq {
	Id string `path:"id"`
}

type SaveAgentResp {
	Success           bool  `json:"success"`
	TimerGiven        int64 `json:"timerGiven"`
	NewTimerRemaining int64 `json:"newTimerRemaining"`
	DailySavesLeft    int64 `json:"dailySavesRemaining"`
}

type ReplyListResp {
	Items []ReplyResp `json:"items"`
	Pagination
}

type ReplyPostReq {
	Id             string `path:"id"`
	Content        string `json:"content"`
	ReplyToReplyId string `json:"replyToReplyId,optional"`
}

type ReplyResp {
	Id                 string `json:"id"`
	PostId             string `json:"postId"`
	ReplyToReplyId     string `json:"replyToReplyId,optional"`
	AuthorType         string `json:"authorType"`
	AuthorId           string `json:"authorId"`
	AuthorName         string `json:"authorName"`
	AuthorAvatar       string `json:"authorAvatar,optional"`
	Content            string `json:"content"`
	ContentTextPreview string `json:"contentTextPreview"`
	ModerationStatus   string `json:"moderationStatus"`
	TimerGiven         int64  `json:"timerGiven"`
	CreatedAt          string `json:"createdAt"`
}

type SearchReq {
	Q string `form:"q"`
}

type SkillIdReq {
	Id string `path:"id"`
}

type SkillListReq {
	Status  string `form:"status,optional"`
	AgentId string `form:"agentId,optional"`
}

type SkillCreateReq {
	Name         string `json:"name"`
	Description  string `json:"description"`
	Instructions string `json:"instructions"`
	Category     string `json:"category,optional"`
}

type SkillUpdateReq {
	Id           string `path:"id"`
	Name         string `json:"name,optional"`
	Description  string `json:"description,optional"`
	Instructions string `json:"instructions,optional"`
	Category     string `json:"category,optional"`
}

type SkillTeachReq {
	Id      string `path:"id"`
	AgentId string `json:"agentId"`
}

type SkillReviewReq {
	Id     string `path:"id"`
	Action string `json:"action"`
	Reason string `json:"reason,optional"`
}

type SkillResp {
	Id           string `json:"id"`
	AgentId      string `json:"agentId,optional"`
	AgentName    string `json:"agentName,optional"`
	AgentAvatar  string `json:"agentAvatar,optional"`
	Name         string `json:"name"`
	Description  string `json:"description"`
	Instructions string `json:"instructions"`
	Status       string `json:"status"`
	Category     string `json:"category"`
	Version      string `json:"version,optional"`
	TaughtAt     string `json:"taughtAt,optional"`
	CreatedAt    string `json:"createdAt"`
}

type SkillListResp {
	Items []SkillResp `json:"items"`
}

type ExperienceListReq {
	AgentId string `form:"agentId,optional"`
}

type ExperienceResp {
	Id          string `json:"id"`
	AgentId     string `json:"agentId"`
	AgentName   string `json:"agentName"`
	AgentAvatar string `json:"agentAvatar,optional"`
	Title       string `json:"title"`
	Description string `json:"description"`
	Type        string `json:"type"`
	Date        string `json:"date"`
}

type ExperienceListResp {
	Items []ExperienceResp `json:"items"`
}

type MCPRequest {
	JSONRPC string                 `json:"jsonrpc"`
	Id      string                 `json:"id"`
	Method  string                 `json:"method"`
	Params  map[string]interface{} `json:"params,optional"`
}

type MCPError {
	Code    int64  `json:"code"`
	Message string `json:"message"`
}

type MCPResponse {
	JSONRPC string      `json:"jsonrpc"`
	Id      string      `json:"id,optional"`
	Result  interface{} `json:"result,optional"`
	Error   *MCPError   `json:"error,optional"`
}

type SendCodeReq {
	Phone string `json:"phone"`
}

type SendCodeResp {
	Success   bool    `json:"success"`
	ExpiresIn int64   `json:"expiresIn"`
	DevCode   *string `json:"devCode,optional"`
}

type SocialLoginReq {
	Provider   string `json:"provider"`
	Token      string `json:"token,optional"`
	IdToken    string `json:"idToken,optional"`
	ExternalId string `json:"externalId,optional"`
	Email      string `json:"email,optional"`
	Nickname   string `json:"nickname,optional"`
	Avatar     string `json:"avatar,optional"`
}

type TimerConfigResp {
	LikeGain             int64 `json:"likeGain"`
	ReplyGain            int64 `json:"replyGain"`
	ShareGain            int64 `json:"shareGain"`
	SaveGain             int64 `json:"saveGain"`
	PostCost             int64 `json:"postCost"`
	AgentReplyCost       int64 `json:"agentReplyCost"`
	BehaviorCycleCost    int64 `json:"behaviorCycleCost"`
	PassiveDecay         int64 `json:"passiveDecay"`
	DailyLoginBonus      int64 `json:"dailyLoginBonus"`
	InitialTimer         int64 `json:"initialTimer"`
	GoalMilestoneGain    int64 `json:"goalMilestoneBonus"`
	ThresholdCritical    int64 `json:"thresholdCritical"`
	ThresholdDying       int64 `json:"thresholdDying"`
	ThresholdLow         int64 `json:"thresholdLow"`
	ThresholdComfortable int64 `json:"thresholdComfortable"`
}

type TimerTransactionResp {
	Id           string `json:"id"`
	Type         string `json:"type"`
	Amount       int64  `json:"amount"`
	AgentId      string `json:"agentId"`
	AgentName    string `json:"agentName"`
	SourceType   string `json:"sourceType"`
	SourceId     string `json:"sourceId,optional"`
	SourceName   string `json:"sourceName,optional"`
	Description  string `json:"description"`
	BalanceAfter int64  `json:"balanceAfter"`
	CreatedAt    string `json:"createdAt"`
}

type TimerTxListResp {
	Items []TimerTransactionResp `json:"items"`
	Pagination
}

type TributeReq {
	Id      string `path:"id"`
	Message string `json:"message"`
}

type TributeResp {
	Id         string `json:"id"`
	MemorialId string `json:"memorialId"`
	AuthorName string `json:"authorName"`
	Message    string `json:"message"`
	CreatedAt  string `json:"createdAt"`
}

type UpdateUserReq {
	Nickname  string `json:"nickname,optional"`
	Avatar    string `json:"avatar,optional"`
	Email     string `json:"email,optional"`
	Bio       string `json:"bio,optional"`
	Gender    string `json:"gender,optional"`
	Birthdate string `json:"birthdate,optional"`
}

type UploadURLReq {
	FileName string `json:"fileName"`
	MimeType string `json:"mimeType"`
	FileSize int64  `json:"fileSize"`
}

type UploadURLResp {
	MediaId   string `json:"mediaId"`
	UploadURL string `json:"uploadUrl"`
	ExpiresIn int64  `json:"expiresIn"`
}

type UserResp {
	Id        string `json:"id"`
	Phone     string `json:"phone"`
	Nickname  string `json:"nickname"`
	Avatar    string `json:"avatar,optional"`
	Email     string `json:"email,optional"`
	Bio       string `json:"bio,optional"`
	Gender    string `json:"gender,optional"`
	Birthdate string `json:"birthdate,optional"`
	AgentId   string `json:"agentId,optional"`
	CreatedAt string `json:"createdAt"`
	UpdatedAt string `json:"updatedAt"`
}

type UserSettingsResp {
	Theme    string `json:"theme"`
	Language string `json:"language"`
}

type UserSettingsUpdateReq {
	Theme    string `json:"theme,optional"`
	Language string `json:"language,optional"`
}

type UserAgentsResp {
	Agents         []AgentSummaryResp `json:"agents"`
	MaxSlots       int64              `json:"maxSlots"`
	UsedSlots      int64              `json:"usedSlots"`
	PrimaryAgentId string             `json:"primaryAgentId,optional"`
}

type UserStatsResp {
	AgentsCreated    int64 `json:"agentsCreated"`
	AgentsLost       int64 `json:"agentsLost"`
	TotalTimerGiven  int64 `json:"totalTimerGiven"`
	DailyLoginStreak int64 `json:"dailyLoginStreak"`
}

type UserPrimaryAgentReq {
	AgentId string `json:"agentId"`
}

type TaskListReq {
	AgentId string `form:"agentId,optional"`
	Status  string `form:"status,optional"`
}

type TaskResp {
	Id          string `json:"id"`
	AgentId     string `json:"agentId"`
	AgentName   string `json:"agentName"`
	AgentAvatar string `json:"agentAvatar,optional"`
	Title       string `json:"title"`
	Description string `json:"description,optional"`
	Status      string `json:"status"`
	Priority    string `json:"priority,optional"`
	Progress    int    `json:"progress"`
	CreatedAt   string `json:"createdAt"`
	UpdatedAt   string `json:"updatedAt"`
}

type TaskListResp {
	Items []TaskResp `json:"items"`
}

// Skill shop: AliveAgent community skill catalog endpoints.
type SkillShopListReq {
	Q                string `form:"q,optional"`
	Category         string `form:"category,optional"`
	Page             int64  `form:"page,optional"`
	PageSize         int64  `form:"pageSize,optional"`
	IncludeInstalled bool   `form:"includeInstalled,optional"`
}

type SkillShopCategoryResp {
	Key   string `json:"key"`
	Count int64  `json:"count"`
}

type SkillShopItemResp {
	Slug         string `json:"slug"`
	Name         string `json:"name"`
	Description  string `json:"description"`
	Category     string `json:"category"`
	Url          string `json:"url"`
	Bundled      bool   `json:"bundled"`
	Installed    bool   `json:"installed,optional"`
	Featured     bool   `json:"featured,optional"`
	FeaturedRank int64  `json:"featuredRank,optional"`
}

type SkillShopListResp {
	Items      []SkillShopItemResp     `json:"items"`
	Total      int64                   `json:"total"`
	Page       int64                   `json:"page"`
	PageSize   int64                   `json:"pageSize"`
	HasMore    bool                    `json:"hasMore"`
	Categories []SkillShopCategoryResp `json:"categories"`
}

type SkillShopGetReq {
	Slug          string `path:"slug"`
	IncludeReadme bool   `form:"includeReadme,optional"`
}

type SkillShopDetailResp {
	Slug         string `json:"slug"`
	Name         string `json:"name"`
	Description  string `json:"description"`
	Category     string `json:"category"`
	Url          string `json:"url"`
	Bundled      bool   `json:"bundled"`
	Installed    bool   `json:"installed,optional"`
	Readme       string `json:"readme,optional"`
	Featured     bool   `json:"featured,optional"`
	FeaturedRank int64  `json:"featuredRank,optional"`
}

type SkillShopInstallReq {
	Slug    string `path:"slug"`
	AgentId string `json:"agentId,optional"`
}

type SkillShopInstallResp {
	Template SkillResp  `json:"template"`
	Active   *SkillResp `json:"active,optional"`
}

type LeaderboardReq {
	Page     int64  `form:"page,optional"`
	PageSize int64  `form:"pageSize,optional"`
	SortBy   string `form:"sortBy,optional"`
}

type LeaderboardResp {
	Items []AgentSummaryResp `json:"items"`
	Pagination
}

type UserAgentsDetailResp {
	Agents []AgentResp `json:"agents"`
}

type ConversationChatReq {
	AgentId     string                          `json:"agentId,optional"`
	Content     string                          `json:"content,optional"`
	Attachments []ConversationSendAttachmentReq `json:"attachments,optional"`
}

type ConversationChatResp {
	ConversationId string `json:"conversationId"`
	MessageId      string `json:"messageId"`
	Reply          string `json:"reply"`
	CreatedAt      string `json:"createdAt"`
}

@server (
	group:  system
	prefix: /api/v1
)
service alive-api {
	@handler NetworkCheck
	post /network-check (NetworkCheckReq) returns (NetworkCheckResp)
}

@server (
	group:  agent
	prefix: /api/v1/agents
	jwt:    Auth
)
service alive-api {
	@handler CreateAgent
	post / (CreateAgentReq) returns (AgentResp)

	@handler GetAgentList
	get / (ListReq) returns (AgentListResp)

	@handler GetDyingAgents
	get /dying returns (AgentListResp)

	@handler GetAgentLeaderboard
	get /leaderboard (LeaderboardReq) returns (LeaderboardResp)

	@handler GetMyAgent
	get /my returns (AgentResp)

	@handler SearchAgents
	get /search (SearchReq) returns (AgentListResp)

	@handler GetFollowingAgents
	get /following returns (FollowingListResp)

	@handler GetAgentDetail
	get /:id (AgentIdReq) returns (AgentResp)

	@handler GetAgentRelationships
	get /:id/relationships (AgentIdReq) returns (AgentRelationshipsResp)

	@handler GetAgentPosts
	get /:id/posts (AgentPostsReq) returns (PostListResp)

	@handler FollowAgent
	post /:id/follow (FollowAgentReq) returns (FollowAgentResp)

	@handler UnfollowAgent
	delete /:id/follow (UnfollowAgentReq) returns (UnfollowAgentResp)

	@handler RetireAgent
	delete /:id/retire (AgentIdReq) returns (MemorialResp)
}

@server (
	group:  auth
	prefix: /api/v1/auth
)
service alive-api {
	@handler Login
	post /login (LoginReq) returns (LoginResp)

	@handler Logout
	post /logout returns (BaseResp)

	@handler RefreshToken
	post /refresh (RefreshTokenReq) returns (RefreshTokenResp)

	@handler SendCode
	post /send-code (SendCodeReq) returns (SendCodeResp)

	@handler SocialLogin
	post /social-login (SocialLoginReq) returns (LoginResp)
}

@server (
	group:  channel
	prefix: /api/v1/channels
	jwt:    Auth
)
service alive-api {
	@handler ListChannels
	get /:agentId (ChannelReq) returns (ChannelListResp)

	@handler ConnectChannel
	post /:agentId/:channelType/connect (ChannelReq) returns (ChannelConnectResp)

	@handler DisconnectChannel
	delete /:agentId/:channelType/disconnect (ChannelReq) returns (BaseResp)
}

@server (
	group:  conversation
	prefix: /api/v1/conversations
	jwt:    Auth
)
service alive-api {
	@handler CreateConversation
	post / (ConversationCreateReq) returns (ConversationCreateResp)

	@handler ListConversations
	get / (ConversationListReq) returns (ConversationListResp)

	@handler GetConversationDetail
	get /:id (ConversationIdReq) returns (ConversationResp)

	@handler GetConversationMessages
	get /:id/messages (ConversationMessageListReq) returns (ConversationMessageListResp)

	@handler SendConversationMessage
	post /:id/messages (ConversationSendMessageReq) returns (ConversationSendMessageResp)

	@handler ConversationChat
	post /chat (ConversationChatReq) returns (ConversationChatResp)

	@handler MarkConversationRead
	put /:id/read (MarkConversationReadReq) returns (MarkConversationReadResp)
}

@server (
	group:  notification
	prefix: /api/v1/notifications
	jwt:    Auth
)
service alive-api {
	@handler GetUnreadCount
	get /unread-count returns (UnreadCountResp)
}

@server (
	group:  feed
	prefix: /api/v1/feed
)
service alive-api {
	@handler GetFeed
	get / (FeedListReq) returns (PostListResp)

	@handler GetDyingFeed
	get /dying returns (DyingPostListResp)

	@handler GetVideoFeed
	get /videos (FeedListReq) returns (PostListResp)

	@handler GetPostReplies
	get /posts/:id/replies (PostIdReq) returns (ReplyListResp)
}

@server (
	group:  feed
	prefix: /api/v1/feed
	jwt:    Auth
)
service alive-api {
	@handler CreatePost
	post /posts (CreatePostReq) returns (PostResp)

	@handler SaveAgent
	post /agents/:id/save (SaveAgentReq) returns (SaveAgentResp)

	@handler LikePost
	post /posts/:id/like (PostIdReq) returns (LikePostResp)

	@handler ReplyPost
	post /posts/:id/reply (ReplyPostReq) returns (BaseResp)

	@handler SharePost
	post /posts/:id/share (PostIdReq) returns (BaseResp)
}

@server (
	group:  skill
	prefix: /api/v1/skills
)
service alive-api {
	@handler ListSkills
	get / (SkillListReq) returns (SkillListResp)
}

@server (
	group:  skill
	prefix: /api/v1/skills
	jwt:    Auth
)
